<?xml version="1.0" encoding="UTF-8"?>
<!--
    Deployment descriptor of the Java-Based Online Quiz Platform.

    The servlets are mapped with the @WebServlet annotation in the Java code;
    this file declares the module (Servlet 4.0 / Tomcat 9) and the welcome file.
    Both approaches are shown so they can be explained during the viva.
-->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Java-Based Online Quiz Platform</display-name>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!--
        NOTE: the four servlets (LoginServlet, QuizServlet, ResultServlet, AdminServlet)
        are registered with the @WebServlet annotation in their Java source files.
        XML-based <servlet>/<servlet-mapping> entries are therefore NOT declared here,
        otherwise Tomcat would report a duplicate mapping for /login.
    -->
</web-app>
